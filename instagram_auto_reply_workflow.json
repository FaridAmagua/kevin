      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 180],
      "continueOnFail": true,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://graph.facebook.com/v21.0/' + $json.media_id + '/comments' }}",
        "sendQuery": true,
        "queryParameters": {
