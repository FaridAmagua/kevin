    {
      "id": "ffffffff-ffff-ffff-ffff-ffffffffffff",
      "name": "Prepare Campaign Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Separar campanas de comentarios procesados\n// Campanas tienen campo 'keyword', procesados tienen campo 'status'\nconst allItems = $input.all();\n\nconst campaigns = allItems.filter(i =>\n  i.json.keyword !== undefined && i.json.keyword !== null\n);\n\nconst processedRows = allItems.filter(i =>\n  i.json.status !== undefined && i.json.status !== null\n);\n\n// Construir set de IDs ya procesados\nconst processedIds = new Set();\nfor (const row of processedRows) {\n  const id = String(row.json.comment_id || '').trim();\n  if (id && id !== '_INIT_ROW') processedIds.add(id);\n}\n\nconst processedIdsArray = Array.from(processedIds);\n\nif (campaigns.length === 0) return [];\n\n// Embeber lista de IDs en cada campana\nreturn campaigns.map(campaign => ({\n  json: {\n    ...campaign.json,\n    _processed_ids: processedIdsArray\n  }\n}));"
      }
    },
