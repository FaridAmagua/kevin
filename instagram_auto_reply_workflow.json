    {
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Detect and Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 180],
      "parameters": {
        "jsCode": "const campaignData = $('Loop Over Campaigns').item.json;\n\nconst keyword = String(campaignData.keyword || '').toLowerCase().trim();\nconst campaignId = campaignData.campaign_id || '';\nconst mediaId = campaignData.media_id || '';\nconst pageId = campaignData.page_id || '1137783109416900';\nconst url = campaignData.url || '';\nconst replyMessage = campaignData.reply_message || '';\nconst processedIds = new Set(\n  Array.isArray(campaignData._processed_ids) ? campaignData._processed_ids : []\n);\n\nconst responseData = $input.first().json;\nif (responseData.error) return [];\n\nconst comments = responseData.data || [];\nif (!Array.isArray(comments) || comments.length === 0) return [];\n\nconst results = [];\nfor (const comment of comments) {\n  const commentText = String(comment.text || '').toLowerCase().trim();\n  const commentId = String(comment.id || '').trim();\n  if (!commentId) continue;\n  if (!commentText.includes(keyword)) continue;\n  if (processedIds.has(commentId)) continue;\n  results.push({\n    json: {\n      comment_id: commentId,\n      campaign_id: campaignId,\n      media_id: mediaId,\n      page_id: pageId,\n      username: String(comment.username || ''),\n      comment_text: comment.text || '',\n      keyword_detected: keyword,\n      url: url,\n      reply_message: replyMessage,\n      timestamp: String(comment.timestamp || '')\n    }\n  });\n}\nreturn results;"
      }
    },
